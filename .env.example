# Copy to .env and fill in. Generate secrets with: npm run keys:generate
NODE_ENV=development
APP_URL=http://localhost:3000

# Owner role: used ONLY for migrations and seeding (prisma.config.ts, prisma/seed.ts)
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/gym_saas?schema=gym-admin-portal
# Restricted app role used by the running application (created by npm run db:setup-roles)
DATABASE_URL=postgresql://gym_app:CHANGE_ME@localhost:5432/gym_saas?schema=gym-admin-portal
DATABASE_SCHEMA=gym-admin-portal
# Password given to the gym_app role by npm run db:setup-roles (must match DATABASE_URL)
APP_DB_PASSWORD=CHANGE_ME

# Test databases for integration + e2e tests (wiped on every test run; never use gym_saas)
TEST_MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/gym_saas_test?schema=gym-admin-portal
TEST_DATABASE_URL=postgresql://gym_app:CHANGE_ME@localhost:5432/gym_saas_test?schema=gym-admin-portal

# Auth.js session signing secret (at least 32 characters)
AUTH_SECRET=CHANGE_ME
AUTH_TRUST_HOST=true

# Field encryption keys (AES-256-GCM): comma-separated "version:base64(32 bytes)" pairs.
# Add a new version and switch ENCRYPTION_ACTIVE_KEY_VERSION to rotate, then run npm run crypto:rotate
ENCRYPTION_KEYS=1:CHANGE_ME
ENCRYPTION_ACTIVE_KEY_VERSION=1
# Blind index key (HMAC-SHA256, base64 32 bytes) for searching encrypted fields such as phone
BLIND_INDEX_KEY=CHANGE_ME
BLIND_INDEX_KEY_VERSION=1

# Uploaded files are stored under STORAGE_DIR/<gymId>/...
STORAGE_DIR=./storage
# dev-outbox writes emails to .dev-outbox/ instead of sending them
EMAIL_PROVIDER=dev-outbox
EMAIL_FROM=FitCRM <no-reply@localhost>
# trace | debug | info | warn | error
LOG_LEVEL=info
# Optional per-IP rate limits (defaults: 30 logins / 15 min, 5 sign-ups / hour)
# RATE_LIMIT_LOGIN_PER_IP=30
# RATE_LIMIT_SIGNUP_PER_IP=5
